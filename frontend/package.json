{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev ",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:integration": "node tests/integration.test.js",
    "test:chat": "node tests/chat_integration.test.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test:e2e": "playwright test",
    "format:check": "prettier --check components/app components/form components/inventory components/customers components/sales components/orders components/team components/agent components/marketing components/dashboard lib/validation lib/api/client.ts lib/api/types.ts hooks/useLoad.ts hooks/useSubmit.ts lib/auth \"app/api/auth\" \"app/(auth)\" lib/format.ts lib/navigation.ts lib/status.ts tests/ui e2e scripts/check-tokens.mjs scripts/check-audit.mjs \"app/(app)\" vitest.config.ts playwright.config.ts",
    "format": "prettier --write components/app components/form components/inventory components/customers components/sales components/orders components/team components/agent components/marketing components/dashboard lib/validation lib/api/client.ts lib/api/types.ts hooks/useLoad.ts hooks/useSubmit.ts lib/auth \"app/api/auth\" \"app/(auth)\" lib/format.ts lib/navigation.ts lib/status.ts tests/ui e2e scripts/check-tokens.mjs scripts/check-audit.mjs \"app/(app)\" vitest.config.ts playwright.config.ts",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o lib/api/schema.d.ts",
    "check:audit": "node scripts/check-audit.mjs"
  },
