# Environment Variables Configuration

# Google Drive MCP Server Configuration
# Path to your Google Drive credentials file (obtained after OAuth authentication)
GDRIVE_CREDENTIALS_PATH=.gdrive-server-credentials.json

# Path to your Google Cloud OAuth keys file (for initial authentication)
# This should be the OAuth 2.0 Client ID JSON file downloaded from Google Cloud Console
GDRIVE_OAUTH_PATH=gcp-oauth.keys.json

# OpenAI API Configuration (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# MCP Server Configuration
MCP_ENDPOINT=https://your-mcp-server.domain/mcp
