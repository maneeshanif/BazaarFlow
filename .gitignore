# Root .gitignore — central rules for the repository

# Python
__pycache__/
*.py[cod]
venv/
.venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/

# Databases (local SQLite)
*.db
*.sqlite
*.sqlite3

# Ignore local env files (keep secrets out of git)
.env
.env.local

# IDEs
.vscode/
.idea/

# Node / frontend
node_modules/
/.next/

# OS
.DS_Store
Thumbs.db