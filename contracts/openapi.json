{
  "components": {
    "schemas": {
      "CustomerCreate": {
        "description": "Limits match the column sizes, so over-long input is a 422 and never a database error.",
        "properties": {
          "address": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "phone": {
            "pattern": "^\\+?[0-9]{7,20}$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "CustomerCreate",
        "type": "object"
      },
      "CustomerOut": {
        "properties": {
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "phone",
          "name",
          "email",
          "address"
        ],
        "title": "CustomerOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "description": "PRD F-001. ``tenant_id`` is only needed when the user belongs to more than one tenant.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "tenant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/TenantMembershipOut"
            },
            "title": "Memberships",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/TenantRole"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "tenant_id",
          "role",
          "memberships"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "description": "PRD F-002: create an account and its first shop in one step.",
        "properties": {
          "accept_terms": {
            "title": "Accept Terms",
            "type": "boolean"
          },
          "city": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 80,
            "minLength": 2,
            "title": "Full Name",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "phone": {
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "title": "Phone",
            "type": "string"
          },
          "shop_name": {
            "maxLength": 80,
            "minLength": 2,
            "title": "Shop Name",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "email",
          "password",
          "shop_name",
          "phone",
          "accept_terms"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "SwitchTenantRequest": {
        "properties": {
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id"
        ],
        "title": "SwitchTenantRequest",
        "type": "object"
      },
      "TenantMembershipOut": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/TenantRole"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          },
          "tenant_name": {
            "title": "Tenant Name",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "tenant_name",
          "role"
        ],
        "title": "TenantMembershipOut",
        "type": "object"
      },
      "TenantRole": {
        "description": "Roles a user can hold inside one tenant. ``platform_admin`` is a flag on ``users``.",
        "enum": [
          "owner",
          "manager",
          "staff"
        ],
        "title": "TenantRole",
        "type": "string"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/TenantRole"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "tenant_id",
          "role"
        ],
        "title": "TokenOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "is_platform_admin": {
            "title": "Is Platform Admin",
            "type": "boolean"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "is_active",
          "is_platform_admin"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VapiFunctionCall": {
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "default": {},
            "title": "Arguments",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "VapiFunctionCall",
        "type": "object"
      },
      "VapiMessage": {
        "properties": {
          "functionCall": {
            "anyOf": [
